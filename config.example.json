{
  "name": "home-work",
  "state_dir": "/var/lib/tailnetlink",
  "tailnets": {
    "home": {
      "tailnet": "keiretsu.ts.net",
      "auth": {"client_id": "home-client", "id_token_file": "/var/run/secrets/tokens/home"}
    },
    "work": {
      "tailnet": "example.ts.net",
      "auth": {"client_id": "work-client", "id_token_file": "/var/run/secrets/tokens/work"},
      "dns": true
    },
    "partner": {
      "tailnet": "partner.example.com",
      "auth": {"client_id": "partner-client", "client_secret_file": "/run/secrets/partner"},
      "dns": false
    }
  },
  "targets": {
    "api": {"in": "home", "tag": "tag:api-server", "ports": [8080, 8443]},
    "db": {"in": "home", "addr": "10.20.0.10", "ports": {"5432": 5432}},
    "app": {"in": "home", "host": "app.internal.example.com", "ports": [443]},
    "ollama": {"in": "pod", "addr": "127.0.0.1", "ports": {"80": 11434}}
  },
  "exports": [
    {"target": "api", "to": ["work", "partner"], "dns_name": "{host}.api.example.com"},
    {"target": "db", "to": ["work"], "name": "db", "dns_name": "db.example.com"},
    {"target": "app", "to": ["work"], "dns_name": "app.example.com"},
    {"target": "ollama", "to": ["work"], "dns_name": "ollama.example.com"}
  ]
}

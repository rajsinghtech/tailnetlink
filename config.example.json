{
  "name": "home-to-work",
  "source": {
    "tailnet": "source-org.ts.net",
    "oauth": {
      "client_id": "YOUR_SOURCE_CLIENT_ID",
      "client_secret_file": "/run/secrets/source-oauth-secret"
    },
    "tags": ["tag:tailnetlink"]
  },
  "dest": {
    "tailnet": "dest-org.ts.net",
    "oauth": {
      "client_id": "YOUR_DEST_CLIENT_ID",
      "client_secret_env": "TAILNETLINK_DEST_OAUTH_SECRET"
    },
    "tags": ["tag:tailnetlink"]
  },
  "links": [
    {
      "name": "api-servers",
      "tag": "tag:api-server",
      "ports": [8080, 8443]
    },
    {
      "name": "databases",
      "devices": [
        { "fqdn": "pg-0.source-org.ts.net", "short_name": "pg-0", "dns_name": "pg-0.db.internal" }
      ],
      "ports": [5432]
    },
    {
      "name": "grafana",
      "local": [
        { "addr": "127.0.0.1:3000", "expose_port": 80, "dns_name": "grafana.home.internal" }
      ]
    }
  ]
}
